compile_commands.json

# Editors
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code: ignore local/personal settings only; keep shared .claude/ files tracked
.claude/settings.local.json

# Local config: holds LINK_KEY, UPDATE_KEY and personal values, also in any copy.
# Never commit; see config/config.h.example
config/config.h*
!config/config.h.example

# Keys: the firmware update signing key and anything like it
*.pem

# Firmware images, flash and crash dumps, and the old build copied from Windows
*.bin
*.elf
built/

# Generated
__pycache__/
*.pyc
.ruff_cache/
docs/guide/full.html

# The Windows-era diffs of src/main.cpp, already applied
LOCAL-CHANGES*.diff

# Local working notes/scratch: never goes to GitHub
.project/


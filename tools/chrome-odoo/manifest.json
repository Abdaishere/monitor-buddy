{
  "manifest_version": 3,
  "name": "Monitor Buddy",
  "version": "1.3",
  "description": "Shows a line on your Monitor Buddy from the toolbar, and (optional) reads your hours, tasks and meetings from www.odoo.com with your signed-in session for the Buddy's Odoo page.",
  "key": "",
  "permissions": [
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://www.odoo.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Say something on the Buddy",
    "default_popup": "popup.html"
  }
}
